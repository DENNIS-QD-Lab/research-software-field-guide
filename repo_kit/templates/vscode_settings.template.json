{
  // Open Markdown files rendered by default (docs, READMEs, run reports); Cmd+Shift+V
  // (Mac) / Ctrl+Shift+V toggles to the raw source for editing. This setting is
  // window-scoped, so it only takes effect when this repo is opened as its own window —
  // it is silently ignored if this folder is opened inside a multi-root workspace
  // alongside other repos. For that case (or to set it up once for every repo), add the
  // same key to your VS Code User Settings instead: see
  // docs/onboarding/02_using_vs_code.md#markdown-preview in research-software-field-guide.
  "workbench.editorAssociations": {
    "*.md": "vscode.markdown.preview.editor"
  }
}
